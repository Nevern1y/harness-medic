{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-medic.dev/schemas/report-v1.schema.json",
  "title": "Harness Medic Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "tool", "scan", "workspace", "privacy", "coverage", "environments", "observations", "findings", "summary", "fixPlans", "internalDiagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "const": "harness-medic" }, "version": { "type": "string" } } },
    "scan": { "type": "object", "additionalProperties": false, "required": ["id", "startedAt", "durationMs", "tier"], "properties": { "id": { "type": "string" }, "startedAt": { "type": "string", "format": "date-time" }, "durationMs": { "type": "number", "minimum": 0 }, "tier": { "type": "integer", "enum": [0, 1, 2] } } },
    "workspace": { "type": "string" },
    "privacy": { "$ref": "#/$defs/privacy" },
    "coverage": { "type": "array", "items": { "$ref": "#/$defs/coverage" } },
    "environments": { "type": "array", "items": { "$ref": "#/$defs/environment" } },
    "observations": { "type": "array", "items": { "$ref": "#/$defs/observation" } },
    "findings": { "type": "array", "items": { "$ref": "#/$defs/finding" } },
    "summary": { "$ref": "#/$defs/summary" },
    "fixPlans": { "type": "array", "items": { "$ref": "#/$defs/fixPlan" } },
    "internalDiagnostics": { "type": "array", "items": { "$ref": "#/$defs/internalDiagnostic" } }
  },
  "$defs": {
    "location": { "type": "object", "additionalProperties": false, "required": ["path"], "properties": { "path": { "type": "string" }, "line": { "type": "integer", "minimum": 0 }, "column": { "type": "integer", "minimum": 0 }, "endLine": { "type": "integer", "minimum": 0 }, "endColumn": { "type": "integer", "minimum": 0 }, "span": { "type": "string" } } },
    "privacy": { "type": "object", "additionalProperties": false, "required": ["redacted", "valuesSerialized", "networkRequests", "childProcesses", "notes"], "properties": { "redacted": { "type": "boolean" }, "valuesSerialized": { "const": false }, "networkRequests": { "type": "integer", "minimum": 0 }, "childProcesses": { "type": "integer", "minimum": 0 }, "notes": { "type": "array", "items": { "type": "string" } } } },
    "coverage": { "type": "object", "additionalProperties": false, "required": ["harness", "detected", "parsed", "precedenceModeled", "runtimeProbed", "behaviorObserved", "gaps"], "properties": { "harness": { "type": "string", "enum": ["claude-code", "codex", "opencode", "cursor"] }, "detected": { "type": "boolean" }, "parsed": { "type": "boolean" }, "precedenceModeled": { "type": "boolean" }, "runtimeProbed": { "type": "boolean" }, "behaviorObserved": { "type": "boolean" }, "gaps": { "type": "array" } } },
    "source": { "type": "object", "additionalProperties": false, "required": ["id", "harness", "kind", "scope", "path", "priority", "applicable", "ownership", "parser", "parseStatus", "diagnostics", "discoveredBy"], "properties": { "id": { "type": "string" }, "harness": { "type": "string" }, "kind": { "type": "string" }, "scope": { "type": "string" }, "path": { "type": "string" }, "priority": { "type": "integer" }, "applicable": { "type": "boolean" }, "ownership": { "type": "string" }, "contentHash": { "type": "string" }, "parser": { "type": "string" }, "parseStatus": { "type": "string" }, "diagnostics": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["code", "message", "severity"], "properties": { "code": { "type": "string" }, "message": { "type": "string" }, "severity": { "type": "string" }, "location": { "$ref": "#/$defs/location" } } } }, "discoveredBy": { "type": "string" }, "formatVersion": { "type": "string" }, "lexicalPath": { "type": "string" }, "realPath": { "type": "string" } } },
    "tokenEstimate": { "type": "object", "additionalProperties": false, "required": ["estimator", "tokens", "exact"], "properties": { "estimator": { "type": "string" }, "tokens": { "type": "integer", "minimum": 0 }, "exact": { "type": "boolean" } } },
    "clause": { "type": "object", "additionalProperties": false, "required": ["id", "modality", "action", "object", "normalized", "sourceSpan"], "properties": { "id": { "type": "string" }, "modality": { "type": "string" }, "action": { "type": "string" }, "object": { "type": "string" }, "condition": { "type": "string" }, "scope": { "type": "string" }, "normalized": { "type": "string" }, "sourceSpan": { "$ref": "#/$defs/location" } } },
    "instruction": { "type": "object", "additionalProperties": false, "required": ["id", "sourceId", "path", "scope", "loadMode", "active", "bytes", "tokenEstimates", "imports", "clauses", "sourceSpan", "textHash", "content", "newline", "finalNewline"], "properties": { "id": { "type": "string" }, "sourceId": { "type": "string" }, "path": { "type": "string" }, "scope": { "type": "string" }, "loadMode": { "type": "string" }, "active": { "type": "boolean" }, "bytes": { "type": "integer", "minimum": 0 }, "tokenEstimates": { "type": "array", "items": { "$ref": "#/$defs/tokenEstimate" } }, "imports": { "type": "array", "items": { "type": "string" } }, "clauses": { "type": "array", "items": { "$ref": "#/$defs/clause" } }, "sourceSpan": { "$ref": "#/$defs/location" }, "textHash": { "type": "string" }, "content": { "type": "string" }, "newline": { "type": "string" }, "finalNewline": { "type": "boolean" } } },
    "tool": { "type": "object", "additionalProperties": false, "required": ["name"], "properties": { "name": { "type": "string" }, "description": { "type": "string" }, "inputSchema": {}, "outputSchema": {}, "annotations": { "type": "object" }, "metadataHash": { "type": "string" } } },
    "observation": { "type": "object", "additionalProperties": false, "required": ["id", "status", "attempts", "evidence"], "properties": { "id": { "type": "string" }, "status": { "type": "string" }, "startedAt": { "type": "string" }, "durationMs": { "type": "number", "minimum": 0 }, "attempts": { "type": "integer", "minimum": 0 }, "evidence": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": { "kind": { "type": "string" }, "value": { "type": "string" }, "location": { "$ref": "#/$defs/location" } } } }, "cleanupStatus": { "type": "string" }, "errorCode": { "type": "string" } } },
    "server": { "type": "object", "additionalProperties": false, "required": ["id", "sourceId", "configuredName", "canonicalIdentity", "transport", "envKeyNames", "enabled", "active", "trust"], "properties": { "id": { "type": "string" }, "sourceId": { "type": "string" }, "configuredName": { "type": "string" }, "canonicalIdentity": { "type": "string" }, "transport": { "type": "string" }, "command": { "type": "string" }, "args": { "type": "array", "items": { "type": "string" } }, "cwd": { "type": "string" }, "url": { "type": "string" }, "envKeyNames": { "type": "array", "items": { "type": "string" } }, "envFingerprint": { "type": "string" }, "enabled": { "type": "boolean" }, "active": { "type": "boolean" }, "trust": { "type": "string" }, "toolInventory": {}, "observation": { "$ref": "#/$defs/observation" }, "configLocation": { "$ref": "#/$defs/location" }, "rawMetadata": { "type": "object" } } },
    "hook": { "type": "object", "additionalProperties": false, "required": ["id", "sourceId", "event", "kind", "target", "active", "validation"], "properties": { "id": { "type": "string" }, "sourceId": { "type": "string" }, "event": { "type": "string" }, "matcher": { "type": "string" }, "kind": { "type": "string" }, "target": { "type": "string" }, "resolvedTarget": { "type": "string" }, "timeout": { "type": "number" }, "active": { "type": "boolean" }, "validation": { "type": "array" }, "observation": { "$ref": "#/$defs/observation" }, "location": { "$ref": "#/$defs/location" } } },
    "permission": { "type": "object", "additionalProperties": false, "required": ["id", "sourceId", "action", "mode", "active"], "properties": { "id": { "type": "string" }, "sourceId": { "type": "string" }, "action": { "type": "string" }, "pattern": { "type": "string" }, "mode": { "type": "string" }, "active": { "type": "boolean" } } },
    "environment": { "type": "object", "additionalProperties": false, "required": ["harness", "adapterVersion", "workspace", "detected", "sources", "activeSourceIds", "shadowEdges", "coverageGaps", "instructions", "mcpServers", "tools", "hooks", "subagents", "permissions", "unknownFields"], "properties": { "harness": { "type": "string" }, "adapterVersion": { "type": "string" }, "harnessVersion": { "type": "string" }, "workspace": { "type": "string" }, "detected": { "type": "boolean" }, "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } }, "activeSourceIds": { "type": "array", "items": { "type": "string" } }, "shadowEdges": { "type": "array" }, "coverageGaps": { "type": "array" }, "instructions": { "type": "array", "items": { "$ref": "#/$defs/instruction" } }, "mcpServers": { "type": "array", "items": { "$ref": "#/$defs/server" } }, "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } }, "hooks": { "type": "array", "items": { "$ref": "#/$defs/hook" } }, "subagents": { "type": "array", "items": { "type": "string" } }, "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } }, "unknownFields": { "type": "object" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "summary", "evidenceClass"], "properties": { "id": { "type": "string" }, "kind": { "type": "string" }, "summary": { "type": "string" }, "value": {}, "sourceId": { "type": "string" }, "location": { "$ref": "#/$defs/location" }, "evidenceClass": { "type": "string" } } },
    "finding": { "type": "object", "additionalProperties": false, "required": ["id", "ruleId", "doctor", "severity", "evidenceClass", "confidence", "title", "summary", "impact", "evidence", "locations", "remediation", "references", "applicable", "observed", "scoreEligible", "scoreImpact", "fixSafety", "fixIds"], "properties": { "id": { "type": "string" }, "ruleId": { "type": "string" }, "doctor": { "type": "string" }, "severity": { "type": "string" }, "evidenceClass": { "type": "string" }, "confidence": { "type": "string" }, "title": { "type": "string" }, "summary": { "type": "string" }, "impact": { "type": "string" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }, "locations": { "type": "array", "items": { "$ref": "#/$defs/location" } }, "remediation": { "type": "string" }, "references": { "type": "array", "items": { "type": "string" } }, "applicable": { "type": "boolean" }, "observed": { "type": "boolean" }, "scoreEligible": { "type": "boolean" }, "scoreImpact": { "type": "number", "minimum": 0 }, "fixSafety": { "type": "string" }, "fixIds": { "type": "array" }, "precisionStatus": { "type": "string" } } },
    "summary": { "type": "object", "additionalProperties": false, "required": ["bySeverity", "byDoctor", "applicable", "observed", "unscored", "deductions"], "properties": { "bySeverity": { "type": "object" }, "byDoctor": { "type": "object" }, "applicable": { "type": "integer" }, "observed": { "type": "integer" }, "unscored": { "type": "integer" }, "healthIndex": { "type": "integer", "minimum": 0, "maximum": 100 }, "deductions": { "type": "array" } } },
    "fixPlan": { "type": "object", "additionalProperties": false, "required": ["id", "findingIds", "safety", "operations", "preconditions", "postconditions", "affectedPaths", "preview"], "properties": { "id": { "type": "string" }, "findingIds": { "type": "array", "items": { "type": "string" } }, "safety": { "type": "string" }, "operations": { "type": "array" }, "preconditions": { "type": "array" }, "postconditions": { "type": "array" }, "affectedPaths": { "type": "array", "items": { "type": "string" } }, "preview": { "type": "string" } } },
    "internalDiagnostic": { "type": "object", "additionalProperties": false, "required": ["id", "phase", "message", "recoverable"], "properties": { "id": { "type": "string" }, "phase": { "type": "string" }, "message": { "type": "string" }, "sourceId": { "type": "string" }, "harness": { "type": "string" }, "recoverable": { "type": "boolean" } } }
  }
}
